import { ScrollView, LineEdit, Button } from "std-widgets.slint";

export struct PageLineData {
    global_idx: int,
    text: string,
}

export struct PageData {
    page_number: int,
    lines: [PageLineData],
}

export component AppWindow inherits Window {
    title: "CollabEdit - Collaborative Document Editor";
    preferred-width: 900px;
    preferred-height: 850px;
    background: #e5e7eb;

    in-out property <[PageData]> pages: [];
    in-out property <int> cursor-line: 0;
    in-out property <int> cursor-col: 0;
    in-out property <string> line-prefix: "";
    in-out property <string> line-suffix: "";
    in-out property <string> username: "";
    in-out property <string> status-text: "Connecting...";
    in-out property <bool> is-logged-in: false;
    in-out property <string> login-error: "";

    // Callbacks to Rust
    callback key-typed(string);
    callback backspace-pressed();
    callback enter-pressed();
    callback arrow-pressed(string); // "up", "down", "left", "right"
    callback login-submitted(string);

    forward-focus: main-scope;

    main-scope := FocusScope {
        key-pressed(event) => {
            if (root.is-logged-in) {
                if (event.text == Key.Backspace) {
                    root.backspace-pressed();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.enter-pressed();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.arrow-pressed("up");
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.arrow-pressed("down");
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.arrow-pressed("left");
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.arrow-pressed("right");
                    return accept;
                }
                if (event.text != "") {
                    root.key-typed(event.text);
                    return accept;
                }
            }
            reject
        }

        // Login overlay screen shown before username is registered
        if !root.is-logged-in: Rectangle {
            width: 100%;
            height: 100%;
            background: #f3f4f6;

            VerticalLayout {
                alignment: center;
                spacing: 20px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 420px;
                        background: #ffffff;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e5e7eb;
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: #0000001a;

                        VerticalLayout {
                            padding: 32px;
                            spacing: 16px;

                            Text {
                                text: "CollabEdit";
                                font-size: 24px;
                                font-weight: 700;
                                color: #111827;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Enter a username to join the collaborative document session.";
                                font-size: 14px;
                                color: #6b7280;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            login-input := LineEdit {
                                placeholder-text: "Your username (e.g. Alice)";
                                text: root.username;
                                font-size: 15px;
                                accepted => {
                                    if (self.text != "") {
                                        root.login-submitted(self.text);
                                    }
                                }
                            }

                            if root.login-error != "": Text {
                                text: root.login-error;
                                font-size: 13px;
                                color: #dc2626;
                                horizontal-alignment: center;
                            }

                            Button {
                                text: "Join Document";
                                primary: true;
                                enabled: login-input.text != "";
                                clicked => {
                                    root.login-submitted(login-input.text);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Main editor view (shown after username is set)
        if root.is-logged-in: VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Top info bar
            HorizontalLayout {
                spacing: 24px;
                Text {
                    text: "User: " + root.username;
                    font-size: 14px;
                    font-weight: 600;
                    color: #1f2937;
                    vertical-alignment: center;
                }
                Text {
                    text: "Status: " + root.status-text;
                    font-size: 14px;
                    color: #059669;
                    vertical-alignment: center;
                }
                Rectangle { } // spacer
                Text {
                    text: "Page " + (Math.floor(root.cursor-line / 35) + 1) + " of " + Math.max(1, root.pages.length);
                    font-size: 14px;
                    color: #4b5563;
                    vertical-alignment: center;
                }
                Text {
                    text: "Ln " + (root.cursor-line + 1) + ", Col " + (root.cursor-col + 1);
                    font-size: 14px;
                    font-family: "monospace";
                    color: #374151;
                    vertical-alignment: center;
                }
            }

            // Workspace background with multi-page layout
            ScrollView {
                VerticalLayout {
                    spacing: 24px;
                    padding-top: 12px;
                    padding-bottom: 36px;
                    alignment: start;

                    for page_data in root.pages: HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 760px;
                            height: 900px;
                            background: #ffffff;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: #d1d5db;
                            drop-shadow-blur: 10px;
                            drop-shadow-offset-y: 3px;
                            drop-shadow-color: #0000001a;

                            TouchArea {
                                clicked => {
                                    main-scope.focus();
                                }
                            }

                            VerticalLayout {
                                padding-top: 40px;
                                padding-bottom: 40px;
                                padding-left: 48px;
                                padding-right: 48px;
                                spacing: 1px;
                                alignment: start;

                                for line in page_data.lines: HorizontalLayout {
                                    height: 23px;
                                    alignment: start;
                                    spacing: 0;

                                    // Active cursor line
                                    if line.global_idx == root.cursor-line: HorizontalLayout {
                                        spacing: 0;
                                        alignment: start;

                                        Text {
                                            text: root.line-prefix;
                                            font-family: "monospace";
                                            font-size: 15px;
                                            color: #111827;
                                            vertical-alignment: center;
                                        }

                                        // The cursor bar
                                        Rectangle {
                                            width: 2px;
                                            height: 19px;
                                            background: #2563eb;
                                        }

                                        Text {
                                            text: root.line-suffix;
                                            font-family: "monospace";
                                            font-size: 15px;
                                            color: #111827;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Inactive lines
                                    if line.global_idx != root.cursor-line: Text {
                                        text: line.text == "" ? " " : line.text;
                                        font-family: "monospace";
                                        font-size: 15px;
                                        color: #111827;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
