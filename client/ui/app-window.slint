import { ScrollView, LineEdit, Button } from "std-widgets.slint";
import "./fonts/DejaVuSansMono.ttf";

export struct PageLineData {
    global_idx: int,
    text: string,
}

export struct PageData {
    page_number: int,
    lines: [PageLineData],
}

export struct ChatMessage {
    sender: string,
    channel: string,
    text: string,
}

export component AppWindow inherits Window {
    title: "CollabEdit - Collaborative Document Editor & Chat";
    preferred-width: 1350px;
    preferred-height: 850px;
    background: #e5e7eb;

    // Document properties
    in-out property <[PageData]> pages: [];
    in-out property <int> cursor-line: 0;
    in-out property <int> cursor-col: 0;
    in-out property <string> line-prefix: "";
    in-out property <string> line-suffix: "";
    in-out property <string> username: "";
    in-out property <string> status-text: "Connecting...";
    in-out property <bool> is-logged-in: false;
    in-out property <string> login-error: "";

    // Channel & Chat properties
    in-out property <[string]> channels: ["general"];
    in-out property <string> active-channel: "general";
    in-out property <[ChatMessage]> messages: [];
    in-out property <bool> show-add-channel-dialog: false;

    // Focus state tracking
    in-out property <bool> input-field-focused: false;

    // Callbacks to Rust
    callback key-typed(string);
    callback backspace-pressed();
    callback enter-pressed();
    callback arrow-pressed(string); // "up", "down", "left", "right"
    callback login-submitted(string);
    callback cursor-position-clicked(int, int); // line, col
    callback channel-selected(string);
    callback send-chat-message(string, string); // channel, text
    callback add-channel-submitted(string); // new channel name

    forward-focus: main-scope;

    main-scope := FocusScope {
        key-pressed(event) => {
            if (root.is-logged-in && !root.input-field-focused) {
                if (event.text == Key.Backspace) {
                    root.backspace-pressed();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.enter-pressed();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.arrow-pressed("up");
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.arrow-pressed("down");
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.arrow-pressed("left");
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.arrow-pressed("right");
                    return accept;
                }
                if (event.text != "") {
                    root.key-typed(event.text);
                    return accept;
                }
            }
            reject
        }

        // Login overlay screen shown before username is registered
        if !root.is-logged-in: Rectangle {
            width: 100%;
            height: 100%;
            background: #f3f4f6;

            VerticalLayout {
                alignment: center;
                spacing: 20px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 420px;
                        background: #ffffff;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e5e7eb;
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: #0000001a;

                        VerticalLayout {
                            padding: 32px;
                            spacing: 16px;

                            Text {
                                text: "CollabEdit";
                                font-size: 24px;
                                font-weight: 700;
                                color: #111827;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Enter a username to join the collaborative document session.";
                                font-size: 14px;
                                color: #6b7280;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            login-input := LineEdit {
                                placeholder-text: "Your username (e.g. Alice)";
                                text: root.username;
                                font-size: 15px;
                                accepted => {
                                    if (self.text != "") {
                                        root.login-submitted(self.text);
                                    }
                                }
                            }

                            if root.login-error != "": Text {
                                text: root.login-error;
                                font-size: 13px;
                                color: #dc2626;
                                horizontal-alignment: center;
                            }

                            Button {
                                text: "Join Document";
                                primary: true;
                                enabled: login-input.text != "";
                                clicked => {
                                    root.login-submitted(login-input.text);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Main workspace (shown after login)
        if root.is-logged-in: VerticalLayout {
            padding: 12px;
            spacing: 10px;

            // Top info bar
            HorizontalLayout {
                spacing: 24px;
                Text {
                    text: "User: " + root.username;
                    font-size: 14px;
                    font-weight: 600;
                    color: #1f2937;
                    vertical-alignment: center;
                }
                Text {
                    text: "Status: " + root.status-text;
                    font-size: 14px;
                    color: #059669;
                    vertical-alignment: center;
                }
                Rectangle { } // spacer
                Text {
                    text: "Channel: #" + root.active-channel;
                    font-size: 14px;
                    font-weight: 600;
                    color: #2563eb;
                    vertical-alignment: center;
                }
                Text {
                    text: "Page " + (Math.floor(root.cursor-line / 35) + 1) + " of " + Math.max(1, root.pages.length);
                    font-size: 14px;
                    color: #4b5563;
                    vertical-alignment: center;
                }
                Text {
                    text: "Ln " + (root.cursor-line + 1) + ", Col " + (root.cursor-col + 1);
                    font-size: 14px;
                    font-family: "DejaVu Sans Mono";
                    color: #374151;
                    vertical-alignment: center;
                }
            }

            // Main body: Channels Sidebar + Document Editor + Chat View
            HorizontalLayout {
                spacing: 12px;

                // 1. Channels Sidebar (Left)
                Rectangle {
                    width: 200px;
                    background: #ffffff;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #d1d5db;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Channels";
                                font-size: 14px;
                                font-weight: 700;
                                color: #374151;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "+";
                                clicked => {
                                    root.show-add-channel-dialog = !root.show-add-channel-dialog;
                                }
                            }
                        }

                        if root.show-add-channel-dialog: VerticalLayout {
                            spacing: 4px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            add-channel-input := LineEdit {
                                placeholder-text: "New channel...";
                                font-size: 12px;
                                accepted => {
                                    if (self.text != "") {
                                        root.input-field-focused = false;
                                        root.add-channel-submitted(self.text);
                                        self.text = "";
                                        root.show-add-channel-dialog = false;
                                        main-scope.focus();
                                    }
                                }
                            }
                            Button {
                                text: "Add";
                                primary: true;
                                enabled: add-channel-input.text != "";
                                clicked => {
                                    root.input-field-focused = false;
                                    root.add-channel-submitted(add-channel-input.text);
                                    add-channel-input.text = "";
                                    root.show-add-channel-dialog = false;
                                    main-scope.focus();
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #e5e7eb;
                        }

                        // List of channels
                        ScrollView {
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                for ch in root.channels: Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: ch == root.active-channel ? #dbeafe : (ch-touch.has-hover ? #f3f4f6 : #ffffff);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "# " + ch;
                                            font-size: 13px;
                                            font-weight: ch == root.active-channel ? 600 : 400;
                                            color: ch == root.active-channel ? #1d4ed8 : #374151;
                                            vertical-alignment: center;
                                        }
                                    }

                                    ch-touch := TouchArea {
                                        clicked => {
                                            root.input-field-focused = false;
                                            root.channel-selected(ch);
                                            main-scope.focus();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 2. Center: Document Pages
                ScrollView {
                    VerticalLayout {
                        spacing: 24px;
                        padding-top: 8px;
                        padding-bottom: 36px;
                        alignment: start;

                        for page_data in root.pages: HorizontalLayout {
                            alignment: center;

                            Rectangle {
                                width: 800px;
                                height: 900px;
                                background: #ffffff;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #d1d5db;
                                drop-shadow-blur: 10px;
                                drop-shadow-offset-y: 3px;
                                drop-shadow-color: #0000001a;

                                VerticalLayout {
                                    padding-top: 40px;
                                    padding-bottom: 40px;
                                    padding-left: 28px;
                                    padding-right: 28px;
                                    spacing: 1px;
                                    alignment: start;

                                    for line in page_data.lines: line-box := Rectangle {
                                        height: 23px;
                                        width: 100%;

                                        // Active cursor line
                                        if line.global_idx == root.cursor-line: HorizontalLayout {
                                            spacing: 0;
                                            alignment: start;

                                            Text {
                                                text: root.line-prefix;
                                                font-family: "DejaVu Sans Mono";
                                                font-size: 15px;
                                                color: #111827;
                                                vertical-alignment: center;
                                                wrap: no-wrap;
                                                overflow: clip;
                                            }

                                            // The cursor bar
                                            Rectangle {
                                                width: 2px;
                                                height: 19px;
                                                background: #2563eb;
                                            }

                                            Text {
                                                text: root.line-suffix;
                                                font-family: "DejaVu Sans Mono";
                                                font-size: 15px;
                                                color: #111827;
                                                vertical-alignment: center;
                                                wrap: no-wrap;
                                                overflow: clip;
                                            }
                                        }

                                        // Inactive lines
                                        if line.global_idx != root.cursor-line: Text {
                                            text: line.text == "" ? " " : line.text;
                                            font-family: "DejaVu Sans Mono";
                                            font-size: 15px;
                                            color: #111827;
                                            vertical-alignment: center;
                                            width: 100%;
                                            wrap: no-wrap;
                                            overflow: clip;
                                        }

                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => {
                                                root.input-field-focused = false;
                                                main-scope.focus();
                                                // 15px monospace character width is approximately 9.02px
                                                root.cursor-position-clicked(line.global_idx, Math.floor(self.mouse-x / 9.02px));
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. Right: Active Channel Chat Panel
                Rectangle {
                    width: 280px;
                    background: #ffffff;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #d1d5db;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Chat header
                        HorizontalLayout {
                            Text {
                                text: "# " + root.active-channel;
                                font-size: 14px;
                                font-weight: 700;
                                color: #1f2937;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #e5e7eb;
                        }

                        // Message history list for active channel
                        ScrollView {
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                for msg in root.messages: Rectangle {
                                    background: msg.sender == root.username ? #eff6ff : #f3f4f6;
                                    border-radius: 4px;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 2px;

                                        Text {
                                            text: msg.sender;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: msg.sender == root.username ? #2563eb : #4b5563;
                                        }

                                        Text {
                                            text: msg.text;
                                            font-size: 13px;
                                            color: #1f2937;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // Message input box
                        HorizontalLayout {
                            spacing: 6px;
                            chat-input := LineEdit {
                                placeholder-text: "Message #" + root.active-channel + "...";
                                font-size: 13px;
                                accepted => {
                                    if (self.text != "") {
                                        root.input-field-focused = false;
                                        root.send-chat-message(root.active-channel, self.text);
                                        self.text = "";
                                        main-scope.focus();
                                    }
                                }
                            }
                            Button {
                                text: "Send";
                                primary: true;
                                enabled: chat-input.text != "";
                                clicked => {
                                    root.input-field-focused = false;
                                    root.send-chat-message(root.active-channel, chat-input.text);
                                    chat-input.text = "";
                                    main-scope.focus();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
